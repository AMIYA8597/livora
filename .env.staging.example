# ==============================================================================
# Flatmate Platform - Isolated Staging Environment Template (.env.staging.example)
# ==============================================================================

# Application Context
ENVIRONMENT=staging
APP_NAME="Flatmate Platform (Staging)"
APP_VERSION=1.0.0-rc.staging
DEBUG=False
LOG_LEVEL=INFO
SECRET_KEY=staging_secret_key_minimum_32_characters_random_token_generate_securely

# Backend & Frontend Staging URLs
API_BASE_URL=https://api-staging.flatmate.platform/api/v1
WEB_BASE_URL=https://staging.flatmate.platform
CORS_ALLOWED_ORIGINS=["https://staging.flatmate.platform","https://flatmate-web-staging.vercel.app","http://localhost:3000","http://127.0.0.1:3000"]
AUTH_REDIRECT_URL=https://staging.flatmate.platform/login

# Staging Database Configuration (Dedicated Isolated PostgreSQL with PostGIS + pgvector)
# Notice: Never point staging to production database.
# Least-privilege API login (scripts/create_app_db_user.sql); never the owner.
DATABASE_URL=postgresql+asyncpg://flatmate_api.PROJECT_REF:APP_DB_PASSWORD@staging-db.project.supabase.co:5432/postgres?ssl=require
# Owner, used only by CI/CD migrations; do not give it to the API runtime.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:OWNER_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_SYNC_URL=postgresql://flatmate_staging_user:STAGING_DB_PASSWORD@staging-db.project.supabase.co:5432/postgres?ssl=require

# Supabase Staging Project Integration
SUPABASE_URL=https://staging-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.staging_public_anon_key_placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.staging_service_role_private_key_placeholder
SUPABASE_JWT_SECRET=staging_jwt_verification_secret_32_characters_minimum
SUPABASE_JWKS_URL=https://staging-project-ref.supabase.co/auth/v1/.well-known/jwks.json
STORAGE_TYPE=supabase
# Storage buckets (physical names). Visibility and limits: apps/api/app/infrastructure/storage_buckets.py;
# apply them to Supabase with scripts/provision_storage.py --apply.
STORAGE_BUCKET_PROPERTIES=properties
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_VERIFICATION=verification
STORAGE_BUCKET_CHAT_ATTACHMENTS=chat-attachments
PROPERTY_PHOTOS_BUCKET=staging-property-photos
VERIFICATION_DOCS_BUCKET=staging-verification-docs

# Redis (Cloud Managed / Upstash / Redis Cloud Free Tier / Local Isolated)
REDIS_URL=rediss://default:STAGING_REDIS_PASSWORD@staging-redis.upstash.io:6379
CELERY_BROKER_URL=rediss://default:STAGING_REDIS_PASSWORD@staging-redis.upstash.io:6379/1
CELERY_RESULT_BACKEND=rediss://default:STAGING_REDIS_PASSWORD@staging-redis.upstash.io:6379/2

# Email & Notifications (Disabled / Test Sink to prevent real customer contact)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_staging_api_key_placeholder
EMAIL_FROM_ADDRESS=staging-notifications@staging.flatmate.platform
EMAIL_FROM_NAME=Flatmate Staging

# Phone verification (SMS one-time codes). Twilio required; India needs DLT registration.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_staging_account_sid_placeholder
TWILIO_AUTH_TOKEN=
# Use a Messaging Service SID (preferred; holds the DLT-registered sender for India) or a sender number.
TWILIO_MESSAGING_SERVICE_SID=MG_staging_messaging_service_placeholder
TWILIO_FROM_NUMBER=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# Rate Limiting & Safety
RATE_LIMIT_CONFIGURATION={"window_seconds":60,"max_requests":60}

# Frontend Browser Public Variables (Safe for client bundle)
NEXT_PUBLIC_APP_URL=https://staging.flatmate.platform
NEXT_PUBLIC_API_URL=https://api-staging.flatmate.platform/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.staging_public_anon_key_placeholder
NEXT_PUBLIC_WS_URL=wss://api-staging.flatmate.platform/api/v1/messaging/ws
