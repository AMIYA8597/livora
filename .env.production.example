# ==============================================================================
# Flatmate Platform - Production Environment Template (.env.production.example)
# DO NOT COMMIT ACTUAL PRODUCTION VALUES. STORE IN HOSTING SECRET MANAGER.
# ==============================================================================

# Application Context
ENVIRONMENT=production
APP_NAME="Flatmate Platform"
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=WARNING
SECRET_KEY=production_cryptographic_secret_key_minimum_64_characters_random_hex

# Backend & Frontend Production URLs
API_BASE_URL=https://api.flatmate.platform/api/v1
WEB_BASE_URL=https://flatmate.platform
CORS_ALLOWED_ORIGINS=["https://flatmate.platform","https://www.flatmate.platform"]

# Production Database Configuration (Managed PostgreSQL with PostGIS + pgvector + Connection Pooler)
# Least-privilege API login (scripts/create_app_db_user.sql); never the owner.
DATABASE_URL=postgresql+asyncpg://flatmate_api.PROJECT_REF:APP_DB_PASSWORD@prod-pooler.supabase.co:6543/postgres?ssl=require
# Owner, used only by CI/CD migrations; do not give it to the API runtime.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:OWNER_PASSWORD@prod-pooler.supabase.com:5432/postgres?ssl=require
DATABASE_SYNC_URL=postgresql://flatmate_prod_user:PROD_DB_PASSWORD@prod-pooler.supabase.co:6543/postgres?ssl=require

# Supabase Production Project Integration
SUPABASE_URL=https://prod-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.prod_public_anon_key_placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.prod_service_role_private_key_placeholder
SUPABASE_JWT_SECRET=production_jwt_verification_secret_high_entropy_token
SUPABASE_JWKS_URL=https://prod-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Storage buckets (physical names). Visibility and limits: apps/api/app/infrastructure/storage_buckets.py;
# apply them to Supabase with scripts/provision_storage.py --apply.
STORAGE_BUCKET_PROPERTIES=properties
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_VERIFICATION=verification
STORAGE_BUCKET_CHAT_ATTACHMENTS=chat-attachments

# Redis (Production Managed High Availability Cluster)
REDIS_URL=rediss://default:PROD_REDIS_PASSWORD@prod-redis.hosted.com:6379

# ---- Security (rate limits, proxies, upload scanning, web CSP) ----
# Rate-limit counts live in Redis (per-process fallback when it's down).
RATE_LIMIT_ENABLED=true
# Proxies in front of the API that append to X-Forwarded-For: 0 = none (local), 1 = Cloud Run.
TRUSTED_PROXY_HOPS=1
# ClamAV daemon for upload virus scans (empty = off). VIRUS_SCAN_REQUIRED refuses uploads
# while the scanner is missing or unreachable.
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
VIRUS_SCAN_REQUIRED=true
# Web: send the CSP as report-only (violations reported, nothing blocked) for a first rollout.
CSP_REPORT_ONLY=false
CELERY_BROKER_URL=rediss://default:PROD_REDIS_PASSWORD@prod-redis.hosted.com:6379/1
CELERY_RESULT_BACKEND=rediss://default:PROD_REDIS_PASSWORD@prod-redis.hosted.com:6379/2

# Email & Notifications (Production Resend / AWS SES with Verified DKIM/SPF)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_live_production_api_key_placeholder
EMAIL_FROM_ADDRESS=notifications@flatmate.platform
EMAIL_FROM_NAME=Flatmate

# Phone verification (SMS one-time codes). Twilio required; India needs DLT registration.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_production_account_sid_placeholder
TWILIO_AUTH_TOKEN=
# Use a Messaging Service SID (preferred; holds the DLT-registered sender for India) or a sender number.
TWILIO_MESSAGING_SERVICE_SID=MG_production_messaging_service_placeholder
TWILIO_FROM_NUMBER=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# AI/ML (apps/api/app/ml). Empty keys = rules, templates and local embeddings only.
# claude-haiku-5-5 costs far less than the default for moderation and reply suggestions.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
AI_MODERATION_ENABLED=true
AI_SMART_REPLIES_ENABLED=true
# EMBEDDING_PROVIDER: local (lexical, no key) | voyage (semantic; then run
# `python -m app.ml.cli backfill-embeddings`)
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=

# Payments (Razorpay auto-renewing subscriptions). Billing is off until all three are set.
# Live rzp_live_ keys only in production. Webhook URL: <API_URL>/api/v1/billing/webhooks/razorpay with the
# subscription.* events; RAZORPAY_WEBHOOK_SECRET is the secret entered for that webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FREE_DAILY_LIKES=25
FREE_ACTIVE_LISTINGS=2

# Web Push (VAPID). Push is on only when both keys are set. Generate a pair with
#   cd apps/api && python -m app.modules.notifications.vapid
# Keep the private key secret and stable: changing it invalidates every browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain.in

# Observability. Error tracking (Sentry) is on only when a DSN is set; reports carry no request
# bodies, cookies, auth headers, query strings or IPs. API logs are JSON lines (Cloud Logging's
# format) outside development/test; set LOG_FORMAT=text|json to override.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
APP_RELEASE=
LOG_LEVEL=INFO
LOG_FORMAT=
GOOGLE_CLOUD_PROJECT=
# Web (set at build time, e.g. in Vercel). Source maps upload only with all three SENTRY_* below.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Rate Limiting & Safety
RATE_LIMIT_CONFIGURATION={"window_seconds":60,"max_requests":30}

# Frontend Browser Public Variables (Safe for client bundle)
# Public origin of the site: canonical links, sitemap and link previews use it. Search engines
# may index the site only when the web app is built with ENVIRONMENT=production.
NEXT_PUBLIC_APP_URL=https://flatmate.platform
NEXT_PUBLIC_API_URL=https://api.flatmate.platform/api/v1
# Server-side page rendering reaches the API here when it has a private address
# (leave unset to use NEXT_PUBLIC_API_URL).
# API_INTERNAL_URL=http://flatmate-api.internal:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://prod-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.prod_public_anon_key_placeholder
NEXT_PUBLIC_WS_URL=wss://api.flatmate.platform/api/v1/messaging/ws
# Never enable outside local development: it puts demo account credentials in the bundle.
NEXT_PUBLIC_DEMO_LOGIN=false
