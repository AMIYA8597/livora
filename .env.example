# ==============================================================================
# Flatmate Platform - Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
PROJECT_NAME="Flatmate Platform"
SECRET_KEY=supersecretkey_please_change_in_production_min_32_chars_1234567890
API_V1_PREFIX=/api/v1

# Frontend Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/messaging/ws
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Backend Database (PostgreSQL with PostGIS and pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flatmate_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flatmate_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/flatmate_db

# Redis (Caching, Rate Limiting, PubSub, Worker queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Object Storage (S3 / MinIO)
STORAGE_TYPE=minio
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=flatmate-media
S3_REGION=us-east-1
S3_USE_SSL=False

# Notifications & Email (SMTP / SendGrid)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@flatmate.platform
SMTP_FROM_NAME="Flatmate Platform"

# Matching Engine Configuration
VECTOR_EMBEDDING_DIM=64
COMPATIBILITY_THRESHOLD=0.60
LIFESTYLE_WEIGHT=0.40
BUDGET_WEIGHT=0.30
LOCATION_WEIGHT=0.20
HABITS_WEIGHT=0.10

# Celery Worker Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
