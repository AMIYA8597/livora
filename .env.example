# ==============================================================================
# Flatmate Platform - Local Development Environment Template (.env.example)
# ==============================================================================

# Application Context
ENVIRONMENT=development
APP_NAME="Flatmate Platform"
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=dev_secret_key_minimum_32_characters_random_token_1234567890

# Backend & Frontend URLs
API_BASE_URL=http://localhost:8000/api/v1
WEB_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL + PostGIS + pgvector)
# Runtime API connection. Outside local dev, use a least-privilege login in the flatmate_app role
# (migration 007 + scripts/create_app_db_user.sql), never the schema owner.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flatmate_db
# Schema-owner URL for Alembic only. Empty = use DATABASE_URL (fine for local dev).
MIGRATION_DATABASE_URL=
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/flatmate_db

# Managed Supabase Service (Local or Free-tier staging)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
# Supabase secret key (Project Settings > API Keys > Secret keys). The legacy anon/service_role
# keys and the legacy JWT secret are not used by the API; turn the legacy keys off.
SUPABASE_SECRET_KEY=sb_secret_placeholder
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Storage buckets (physical names). Visibility and limits: apps/api/app/infrastructure/storage_buckets.py;
# apply them to Supabase with scripts/provision_storage.py --apply.
STORAGE_BUCKET_PROPERTIES=properties
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_VERIFICATION=verification
STORAGE_BUCKET_CHAT_ATTACHMENTS=chat-attachments

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# ---- Security (rate limits, proxies, upload scanning, web CSP) ----
# Rate-limit counts live in Redis (per-process fallback when it's down).
RATE_LIMIT_ENABLED=true
# Proxies in front of the API that append to X-Forwarded-For: 0 = none (local), 1 = Cloud Run.
TRUSTED_PROXY_HOPS=0
# ClamAV daemon for upload virus scans (empty = off). VIRUS_SCAN_REQUIRED refuses uploads
# while the scanner is missing or unreachable.
CLAMAV_HOST=
CLAMAV_PORT=3310
VIRUS_SCAN_REQUIRED=false
# Web: send the CSP as report-only (violations reported, nothing blocked) for a first rollout.
CSP_REPORT_ONLY=false
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Worker (python -m app.workers.run): beat runs inside it unless WORKER_EMBED_BEAT=false; run
# exactly one with beat. On Windows set WORKER_POOL=solo and WORKER_EMBED_BEAT=false (run
# `celery -A app.workers.celery_app beat` separately).
# WORKER_EMBED_BEAT=true
# WORKER_CONCURRENCY=2
# WORKER_POOL=
# Maintenance and ranker training may run statements this long (the API login allows 15s).
# WORKER_STATEMENT_TIMEOUT_SECONDS=600

# Email & Notifications
# EMAIL_PROVIDER: smtp (local Mailpit, inbox at http://localhost:8025) | resend (production) | memory (dev/test only)
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=notifications@flatmate.local
EMAIL_FROM_NAME=Flatmate
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
PASSWORD_RESET_EXPIRE_MINUTES=15

# Phone verification (SMS one-time codes)
# SMS_PROVIDER: memory (dev/test only; code is echoed in the API response) | twilio (staging/production)
SMS_PROVIDER=memory
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# AI/ML (apps/api/app/ml). Empty keys = rules, templates and local embeddings only.
# claude-haiku-5-5 costs far less than the default for moderation and reply suggestions.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
AI_MODERATION_ENABLED=true
AI_SMART_REPLIES_ENABLED=true
# EMBEDDING_PROVIDER: local (lexical, no key) | voyage (semantic; then run
# `python -m app.ml.cli backfill-embeddings`)
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=

# Payments (Razorpay auto-renewing subscriptions). Billing is off until all three are set.
# Use rzp_test_ keys here. Webhook URL: <API_URL>/api/v1/billing/webhooks/razorpay with the
# subscription.* events; RAZORPAY_WEBHOOK_SECRET is the secret entered for that webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FREE_DAILY_LIKES=25
FREE_ACTIVE_LISTINGS=2

# Web Push (VAPID). Push is on only when both keys are set. Generate a pair with
#   cd apps/api && python -m app.modules.notifications.vapid
# Keep the private key secret and stable: changing it invalidates every browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@flatmate.local

# Native push for the Android and iOS apps (each platform is on only when all its values are set).
# Android: Firebase project id and a service-account key's JSON (one line) with the
# "Firebase Cloud Messaging API Admin" role. iOS: an APNs .p8 key's contents (newlines as 
),
# its key id, your team id and the app's bundle id; APNS_SANDBOX=true for development builds.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_SANDBOX=false

# Mobile app versions. Below the minimum, API calls answer 426 "please update". Empty = none.
MIN_APP_VERSION_ANDROID=
MIN_APP_VERSION_IOS=
LATEST_APP_VERSION_ANDROID=
LATEST_APP_VERSION_IOS=
APP_STORE_URL_ANDROID=
APP_STORE_URL_IOS=

# Web: deep links (served at /.well-known/assetlinks.json and /.well-known/apple-app-site-association,
# 404 until set). Package name and signing-key SHA-256 fingerprints (comma-separated, AB:CD:...),
# and iOS app ids as TEAMID.bundle.id (comma-separated).
ANDROID_APP_PACKAGE=
ANDROID_APP_SHA256_FINGERPRINTS=
IOS_APP_IDS=

# Observability. Error tracking (Sentry) is on only when a DSN is set; reports carry no request
# bodies, cookies, auth headers, query strings or IPs. API logs are JSON lines (Cloud Logging's
# format) outside development/test; set LOG_FORMAT=text|json to override.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
APP_RELEASE=
LOG_LEVEL=INFO
LOG_FORMAT=
GOOGLE_CLOUD_PROJECT=
# Web (set at build time, e.g. in Vercel). Source maps upload only with all three SENTRY_* below.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Rate Limiting & Safety
RATE_LIMIT_CONFIGURATION={"window_seconds":60,"max_requests":120}

# Frontend Browser Public Variables (Safe for client bundle)
# Public origin of the site: canonical links, sitemap and link previews use it. Search engines
# may index the site only when the web app is built with ENVIRONMENT=production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Server-side page rendering reaches the API here (leave unset to use NEXT_PUBLIC_API_URL).
# API_INTERNAL_URL=http://api:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_placeholder
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/messaging/ws
# Local development only: shows quick-login buttons for the seeded demo accounts.
NEXT_PUBLIC_DEMO_LOGIN=true
