# Production Dockerfile for API Service
FROM python:3.12-slim as builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/pyproject.toml apps/api/README.md apps/api/constraints.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip wheel --no-cache-dir --no-deps --wheel-dir /app/wheels .

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r -g 10001 flatmate && \
    useradd -r -u 10001 -g flatmate -s /bin/false -d /app flatmate

COPY --from=builder /app/wheels /wheels
COPY --from=builder /app/constraints.txt /tmp/constraints.txt
# Dependencies at the versions CI tested (apps/api/constraints.txt).
RUN pip install --no-cache -c /tmp/constraints.txt /wheels/*

COPY apps/api /app
RUN chown -R flatmate:flatmate /app

USER flatmate

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health/live || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
