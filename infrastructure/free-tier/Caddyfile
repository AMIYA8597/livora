# HTTPS in front of the API. Caddy gets and renews the Let's Encrypt certificate for
# API_DOMAIN by itself; ports 80 and 443 must be open to the internet (provision-azure.sh does it).
{
	email {$ACME_EMAIL}
	admin off
}

{$API_DOMAIN} {
	encode zstd gzip

	# The API's own limit is 16 MB for uploads and 10 MB otherwise; this stops anything bigger
	# before it reaches Python.
	request_body {
		max_size 20MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
	}

	# Caddy replaces any X-Forwarded-For a client sends with the real client address, so the
	# API trusts exactly one proxy hop (TRUSTED_PROXY_HOPS=1). WebSockets pass through as-is.
	reverse_proxy api:8000 {
		transport http {
			keepalive 60s
		}
	}
}
