# Production settings for the free-tier launch (docs/FREE_TIER_LAUNCH.md).
#
#   1. Copy this file to .env.free-tier at the repository root (git ignores that name).
#   2. Fill the blanks. Never commit the copy, and never paste its values into a chat.
#   3. Run:  python scripts/production_setup.py
#      It sets the GitHub secrets and variables the deploy reads, printing names only.
#
# KEY=value, one per line. No quotes are needed; quotes and line breaks inside values are refused.

# ---- Supabase (required) ------------------------------------------------------------
# Project id: the part before .supabase.co in the project URL.
SUPABASE_PROJECT_REF=
# Project Settings → Database → Connect → Session pooler: the host, aws-N-<region>.pooler.supabase.com
SUPABASE_POOLER_HOST=
# The database password. Reset it first (Project Settings → Database → Reset database password).
SUPABASE_DB_PASSWORD=
# A new secret key (Project Settings → API Keys → Create new secret key): sb_secret_...
SUPABASE_SECRET_KEY=

# ---- Addresses ----------------------------------------------------------------------
# With your own domain (DNS records in docs/FREE_TIER_LAUNCH.md, step 5), both run on the VM:
#   API_DOMAIN=api.<your-domain>
#   WEB_URL=https://<your-domain>        (the bare domain; www.<your-domain> redirects to it)
# The API's host name: api.<your-domain>, or <DNS_LABEL>.<region>.cloudapp.azure.com before you have one
API_DOMAIN=
# The website's address: https://<your-domain> (an https://<project>.vercel.app address keeps it on Vercel)
WEB_URL=
# www.<site> redirecting to the site: decided from WEB_URL (yes for example.com, no for an Azure
# name like <label>.<region>.cloudapp.azure.com). Set true or false to decide yourself.
WEB_WWW_REDIRECT=
# Where Let's Encrypt sends certificate-expiry notices
ACME_EMAIL=

# ---- Email: Brevo (needed for password resets) --------------------------------------
# Brevo → SMTP & API → SMTP: the login, and an SMTP key you generate there
SMTP_USERNAME=
SMTP_PASSWORD=
# A sender address you verified in Brevo → Senders
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Flatmate

# ---- Optional -----------------------------------------------------------------------
# Sentry project DSN (error tracking)
SENTRY_DSN=
# Claude for AI moderation and smart replies. Paid per use; leave empty to keep them off.
ANTHROPIC_API_KEY=
