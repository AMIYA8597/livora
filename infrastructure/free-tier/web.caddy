# The website, served from the `web` container. deploy.sh copies this file into sites/ when it is
# given WEB_IMAGE and WEB_DOMAIN, and removes it otherwise; the Caddyfile imports it.
# web-www.caddy (www.<domain> redirecting here) goes with it unless WEB_WWW=0.

{$WEB_DOMAIN} {
	encode zstd gzip

	# The website takes no uploads itself (photos go straight to the API).
	request_body {
		max_size 2MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-Via
		-X-Powered-By
	}

	reverse_proxy web:3000 {
		transport http {
			keepalive 60s
		}
	}
}
