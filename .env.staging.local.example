# ==============================================================================
# Flatmate Platform - Local Isolated Staging Environment (.env.staging.local.example)
# Use this when running an isolated staging verification drill on staging host.
# ==============================================================================

ENVIRONMENT=staging
APP_NAME="Flatmate Platform (Staging Local)"
APP_VERSION=1.0.0-rc.staging
DEBUG=False
LOG_LEVEL=INFO
SECRET_KEY=staging_local_cryptographic_secret_key_min_32_chars_1234567890

# URLs
API_BASE_URL=http://localhost:8001/api/v1
WEB_BASE_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001","http://localhost:3000"]
AUTH_REDIRECT_URL=http://localhost:3001/login

# Dedicated Disposable Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flatmate_staging_disposable
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/flatmate_staging_disposable

# Supabase Auth / Local JWT
SUPABASE_URL=http://localhost:54321
# Supabase secret key (Project Settings > API Keys > Secret keys). The legacy anon/service_role
# keys and the legacy JWT secret are not used by the API; turn the legacy keys off.
SUPABASE_SECRET_KEY=sb_secret_placeholder
SUPABASE_JWKS_URL=http://localhost:54321/auth/v1/.well-known/jwks.json
# Storage buckets (physical names). Visibility and limits: apps/api/app/infrastructure/storage_buckets.py;
# apply them to Supabase with scripts/provision_storage.py --apply.
STORAGE_BUCKET_PROPERTIES=properties
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_VERIFICATION=verification
STORAGE_BUCKET_CHAT_ATTACHMENTS=chat-attachments

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email Sink
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=staging-test@flatmate.local
SMTP_HOST=localhost
SMTP_PORT=1025

# Phone verification (SMS one-time codes)
# SMS_PROVIDER: memory (dev/test only; code is echoed in the API response) | twilio (staging/production)
SMS_PROVIDER=memory
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# Storage
STORAGE_TYPE=local
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=staging-media

# Frontend Public Variables
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8001/api/v1/messaging/ws
# Never enable outside local development: it puts demo account credentials in the bundle.
NEXT_PUBLIC_DEMO_LOGIN=false
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
