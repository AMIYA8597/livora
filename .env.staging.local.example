# ==============================================================================
# Flatmate Platform - Local Isolated Staging Environment (.env.staging.local.example)
# Use this when running an isolated staging verification drill on staging host.
# ==============================================================================

ENVIRONMENT=staging
APP_NAME="Flatmate Platform (Staging Local)"
APP_VERSION=1.0.0-rc.staging
DEBUG=False
LOG_LEVEL=INFO
SECRET_KEY=staging_local_cryptographic_secret_key_min_32_chars_1234567890

# URLs
API_BASE_URL=http://localhost:8001/api/v1
WEB_BASE_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001","http://localhost:3000"]
AUTH_REDIRECT_URL=http://localhost:3001/login

# Dedicated Disposable Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flatmate_staging_disposable
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/flatmate_staging_disposable

# Supabase Auth / Local JWT
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.staging_local_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.staging_local_service_role_key
SUPABASE_JWT_SECRET=staging_local_jwt_secret_32_characters_minimum_entropy
SUPABASE_JWKS_URL=http://localhost:54321/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=flatmate-media-staging

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email Sink
EMAIL_PROVIDER=test-sink
EMAIL_FROM_ADDRESS=staging-test@flatmate.local
MOCK_EMAIL_DELIVERY=True

# Storage
STORAGE_TYPE=local
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=staging-media

# Frontend Public Variables
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8001/api/v1/messaging/ws
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.staging_local_anon_key
